# ============================================================
# PT 站点统一配置模板: cp .env.example .env 后填写
# ============================================================

# ---- azusa.wiki ----
AZUSA_USERNAME=your_username
AZUSA_PASSWORD=your_password
AZUSA_PROXY=http://127.0.0.1:7890

# ---- tjupt.org ----
TJPT_USERNAME=your_username
TJPT_PASSWORD=your_password

# ---- u2.dmhy.org ----
DMHY_USERNAME=your_email@example.com
DMHY_PASSWORD=your_password
# 四站统一的手动 cookie 方式: 把 cookie 文件放进 data/cookies/<站点目录>/ 或用油猴一键发送

# ---- 全局代理(可选) ----
HTTP_PROXY=http://127.0.0.1:20170
HTTPS_PROXY=http://127.0.0.1:20170

# ---- 钉钉企业内部应用机器人(推送 + stream 接收) ----
DINGTALK_WEBHOOK=your_robot_webhook   # 主动推送 webhook
DINGTALK_SECRET=                      # 开启"加签"时填 SEC 密钥, 未开则留空
DINGTALK_CLIENT_ID=your_client_id     # stream 模式 AppKey(接收 @ 消息)
DINGTALK_CLIENT_SECRET=your_client_secret

# ---- cookie 接收服务(油猴脚本 → 服务器) ----
# 服务经 frp 公网暴露, token 必须设置;deploy/install.sh 会自动生成随机值
COOKIE_SERVER_TOKEN=

# ============================================================
# 统一可调配置(全部用户可修改项集中于此; 留空/删除 = 用代码默认值)
# ============================================================

# ---- 通用行为 ----
HTTP_TIMEOUT=30               # HTTP 请求超时秒数(搜索/签到/预检)
RETRY_MAX=3                   # 签到失败自动重试次数(登录失效→自动登录重试)
RETRY_INTERVAL=30             # 重试间隔秒
ATTEMPTS_WARN=2               # 剩余登录次数 ≤N 时警告且不登录
PREPCHECK_TIMEOUT=15          # 登录前预检超时秒数

# ---- 各站登录/签到参数 ----
AZUSA_MAX_ATTEMPTS=5          # azusa 单次运行最大登录尝试
TJPT_MAX_RETRIES=10           # tjupt 海报 OCR 签到最大换题重试

# ---- frp 公网(油猴 cookie 发送地址) ----
FRP_PUBLIC_IP=your_frp_public_ip

# ---- cookie 接收服务(pt-cookie-server) ----
COOKIE_DOWNLOAD_TOKEN=            # 下载端点独立鉴权(install.sh 自动生成)
COOKIE_SERVER_HOST=127.0.0.1  # 默认只绑回环, 由 frp 转发
COOKIE_SERVER_PORT=8766
COOKIE_SERVER_MAX_BODY=1048576  # body 上限字节(1 MiB)

# ---- 钉钉机器人回复 ----
BOT_REPLY_LIMIT=4             # @机器人搜索每站展示条数(手机端建议 4-6)
DINGTALK_BOT_NAME=pt 助手           # 机器人昵称(用于清洗 @提及; 留空用兜底规则)

# ---- cookie 存储目录(四站 cookie 文件统一存放, 相对项目根) ----
COOKIE_DIR=data/cookies
